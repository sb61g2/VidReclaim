<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>VidReclaim</title>
  <organization>io.vidreclaim</organization>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <allowed-os-versions>
    <os-version min="26.0"/>
  </allowed-os-versions>
  <welcome file="welcome.html"/>
  <readme file="readme.html"/>
  <license file="license.html"/>
  <conclusion file="conclusion.html"/>
  <choices-outline>
    <line choice="default">
      <line choice="io.vidreclaim.pkg"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="io.vidreclaim.pkg" visible="false">
    <pkg-ref id="io.vidreclaim.pkg"/>
  </choice>
  <pkg-ref id="io.vidreclaim.pkg" version="@VERSION@" onConclusion="none">vidreclaim-component.pkg</pkg-ref>
</installer-gui-script>
